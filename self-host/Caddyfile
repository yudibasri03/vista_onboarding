# Caddy reverse proxy + HTTPS otomatis untuk self-hosted Supabase.
# Ganti api.namamu.com dengan domain/subdomain kamu (A record -> IP VPS).
# Caddy akan mengurus sertifikat Let's Encrypt secara otomatis.
#
# Jalankan (di folder yang sama dengan Caddyfile ini):
#   caddy run
# atau sebagai service:
#   caddy start
#
# Supabase docker meng-expose API gateway (Kong) di localhost:8000.

api.namamu.com {
	encode gzip
	reverse_proxy localhost:8000
}
