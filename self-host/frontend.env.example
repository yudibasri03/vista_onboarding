# Nilai untuk FRONTEND (React app).
# - Untuk dev lokal: salin ke file .env di root project.
# - Untuk produksi: set sebagai Environment Variables di Vercel
#   (Project Settings > Environment Variables), lalu Redeploy.
#
# VITE_SUPABASE_URL  = domain API self-hosted kamu (yang di-proxy Caddy).
# VITE_SUPABASE_ANON_KEY = ANON_KEY hasil generate-keys.mjs.

VITE_SUPABASE_URL=https://api.namamu.com
VITE_SUPABASE_ANON_KEY=ganti-dengan-ANON_KEY-dari-generate-keys.mjs
